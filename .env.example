# Copy to .env and adjust for local development.
DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-min

# docker-compose Postgres settings (must match DATABASE_URL).
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
POSTGRES_PORT=5432
